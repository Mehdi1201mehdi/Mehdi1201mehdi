<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Thème de base : sombre, comme l'application. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/coach_fond</item>
        <item name="colorPrimaryDark">@color/coach_fond</item>
        <item name="colorAccent">#2478FF</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Barres système à la couleur du fond : pas de bande claire en haut ni en bas. -->
        <item name="android:statusBarColor">@color/coach_fond</item>
        <item name="android:navigationBarColor">@color/coach_fond</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/coach_fond</item>
    </style>

    <!-- Écran de démarrage. Android 12+ : fond sombre + haltère blanc (API SplashScreen).
         Android < 12 : image @drawable/splash générée aux couleurs de l'app. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/coach_fond</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
